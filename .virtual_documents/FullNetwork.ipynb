# ============================================================
# Network de co-ocurrencia de keywords
#
# Nodo:
#   - Keyword
#   - N_Papers = cantidad de papers donde aparece
#
# Arista:
#   - Weight = cantidad de papers donde ambas keywords aparecen juntas
# ============================================================

import pandas as pd
import networkx as nx
from itertools import combinations
import matplotlib.pyplot as plt
import seaborn as sns

# ------------------------------------------------------------
# Limpiar keywords por paper
# ------------------------------------------------------------

paper_keywords = []

for keyword_list in keywords:

    clean_keywords = []

    for keyword in keyword_list:

        if isinstance(keyword, dict):
            term = keyword.get("Keyword") or keyword.get("Text") or keyword.get("Term")
        else:
            term = keyword

        if term:
            clean_keywords.append(str(term).strip())

    # evitar duplicados dentro del mismo paper
    clean_keywords = list(dict.fromkeys(clean_keywords))

    paper_keywords.append(clean_keywords)


# ------------------------------------------------------------
# Frecuencia de cada keyword
# ------------------------------------------------------------

keyword_frequency = {}

for kw_list in paper_keywords:
    for kw in kw_list:
        keyword_frequency[kw] = keyword_frequency.get(kw, 0) + 1


# ------------------------------------------------------------
# Co-ocurrencias
# ------------------------------------------------------------

keyword_edges = {}

for kw_list in paper_keywords:

    for kw1, kw2 in combinations(sorted(kw_list), 2):

        pair = (kw1, kw2)

        keyword_edges[pair] = keyword_edges.get(pair, 0) + 1


# ------------------------------------------------------------
# Crear graph
# ------------------------------------------------------------

G_keywords = nx.Graph()


# Nodos
for keyword, n_papers in keyword_frequency.items():

    G_keywords.add_node(keyword, N_Papers=n_papers)


# Aristas
for (kw1, kw2), weight in keyword_edges.items():

    G_keywords.add_edge(kw1, kw2, Weight=weight)


print("Keywords:", G_keywords.number_of_nodes())
print("Relaciones:", G_keywords.number_of_edges())



# ============================================================
# Tablas de nodos y relaciones
# ============================================================

keyword_nodes = (
    pd.DataFrame(
        [
            {"Keyword": node, "N_Papers": data["N_Papers"]}
            for node, data in G_keywords.nodes(data=True)
        ]
    )
    .sort_values("N_Papers", ascending=False)
    .reset_index(drop=True)
)


keyword_relations = (
    pd.DataFrame(
        [
            {"Keyword1": u, "Keyword2": v, "Weight": data["Weight"]}
            for u, v, data in G_keywords.edges(data=True)
        ]
    )
    .sort_values("Weight", ascending=False)
    .reset_index(drop=True)
)


display(keyword_nodes)
display(keyword_relations)



# ============================================================
# Guardar para recuperación rápida
# ============================================================

nx.write_gexf(G_keywords, os.path.join("ml_pubmed_ifibio", "keyword_network.gexf"))

keyword_nodes.to_pickle(os.path.join("ml_pubmed_ifibio", "keyword_nodes.pkl"))

keyword_relations.to_pickle(os.path.join("ml_pubmed_ifibio", "keyword_relations.pkl"))

print("Guardados:")
print("keyword_network.gexf")
print("keyword_nodes.pkl")
print("keyword_relations.pkl")

# ============================================================
# Plot global
#
# Para que sea legible:
# mostrar keywords presentes en >= 3 papers
# ============================================================

selected_keywords = [
    node for node in G_keywords.nodes() if G_keywords.nodes[node]["N_Papers"] >= 3
]

Gk = G_keywords.subgraph(selected_keywords).copy()


print("Keywords graficadas:", Gk.number_of_nodes())
print("Relaciones graficadas:", Gk.number_of_edges())


# Layout
pos_keywords = nx.spring_layout(Gk, weight="Weight", k=0.9, iterations=150, seed=42)


# Tamaño según frecuencia
node_sizes = [80 + Gk.nodes[node]["N_Papers"] * 50 for node in Gk.nodes()]


# Grosor según co-ocurrencia
edge_widths = [0.2 + Gk[u][v]["Weight"] * 0.5 for u, v in Gk.edges()]


# Color según frecuencia
node_colors = [Gk.nodes[node]["N_Papers"] for node in Gk.nodes()]


# ============================================================
# Plot
# ============================================================

plt.figure(figsize=(18, 18))


nx.draw_networkx_edges(
    Gk, pos_keywords, width=edge_widths, edge_color="gray", alpha=0.15
)


nodes_plot = nx.draw_networkx_nodes(
    Gk,
    pos_keywords,
    node_size=node_sizes,
    node_color=node_colors,
    cmap="viridis",
    alpha=0.9,
)


# Etiquetas solo para keywords frecuentes
median_frequency = pd.Series(
    [Gk.nodes[node]["N_Papers"] for node in Gk.nodes()]
).median()


labels = {node: node for node in Gk.nodes() if Gk.nodes[node]["N_Papers"] > 2}


nx.draw_networkx_labels(Gk, pos_keywords, labels=labels, font_size=8)


plt.colorbar(nodes_plot, label="Número de publicaciones", shrink=0.6)

