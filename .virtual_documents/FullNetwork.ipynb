import ast
import pandas as pd
import matplotlib.pyplot as plt

authors = df["Authors"].apply(
    lambda x: (
        ast.literal_eval(x)
        if isinstance(x, str)
        else (x if isinstance(x, list) else [])
    )
)


# Una fila por autor × filiación × paper
affiliation_records = []

for pmid, author_list in zip(df["PMID"], authors):

    for author in author_list:

        author_name = author.get("AuthorClean")

        for aff in author.get("Affiliations", []):

            affiliation = aff.get("Affiliation")

            if affiliation:

                affiliation_records.append(
                    {"PMID": pmid, "Author": author_name, "Affiliation": affiliation}
                )


affiliations_df = pd.DataFrame(affiliation_records)

print("Registros autor × filiación:", len(affiliations_df))
print("Filiaciones diferentes:", affiliations_df["Affiliation"].nunique())

display(affiliations_df)

# guardar afiliaciones_df en un archivo CSV
affiliations_df.to_csv(os.path.join(OUTPUT_DIR, "author_affiliations.csv"), index=False)



# ============================================================
# Estadísticas de filiaciones
# ============================================================

affiliation_stats = (
    affiliations_df.groupby("Affiliation")
    .agg(
        N_records=("PMID", "size"),
        N_papers=("PMID", "nunique"),
        N_authors=("Author", "nunique"),
    )
    .sort_values("N_papers", ascending=False)
    .reset_index()
)

display(affiliation_stats)

# save to CSV
affiliation_stats.to_csv("affiliation_stats.csv", index=False)





# ============================================================
# Top 25 filiaciones por número de papers
# ============================================================

top_affiliations = affiliation_stats.head(25)
top_affiliations["Affiliation"] = top_affiliations["Affiliation"].str.slice(
    0, 25
) + top_affiliations["Affiliation"].apply(lambda x: "…" if len(x) > 25 else "")
plt.figure(figsize=(10, 9))

plt.barh(top_affiliations["Affiliation"], top_affiliations["N_papers"])

plt.xlabel("Número de publicaciones")
plt.ylabel("Filiación")
plt.title("Principales filiaciones presentes en las publicaciones")

plt.gca().invert_yaxis()

plt.tight_layout()
plt.show()




# Matriz de co-ocurrencia: filas = filiaciones, columnas = autores, valor = número de papers compartidos
affil_author_matrix = pd.crosstab(
    affiliations_df["Affiliation"], affiliations_df["Author"]
)

display(affil_author_matrix)

# Guardar matriz de co-ocurrencia afiliación-autor
affil_author_matrix.to_csv(os.path.join(OUTPUT_DIR, "affiliation_author_matrix.csv"))

# ============================================================
# Matriz de co-ocurrencia: Filiaciones × Filiaciones
# ============================================================

# Para cada paper, obtener todas las combinaciones de filiaciones presentes
from itertools import combinations

# Crear lista de listas de filiaciones por paper
paper_affiliations = (
    affiliations_df.groupby("PMID")["Affiliation"].apply(lambda x: list(set(x))).tolist()
)

# Inicializar diccionario para contar co-ocurrencias
from collections import Counter

affil_cooc_counter = Counter()

for affil_list in paper_affiliations:
    # Solo considerar papers con al menos 2 filiaciones distintas
    for aff1, aff2 in combinations(sorted(affil_list), 2):
        affil_cooc_counter[(aff1, aff2)] += 1

# Convertir a DataFrame
affil_cooc_df = pd.DataFrame(
    [(a1, a2, w) for (a1, a2), w in affil_cooc_counter.items()],
    columns=["Affiliation1", "Affiliation2", "Weight"],
)

display(affil_cooc_df.sort_values("Weight", ascending=False).head(20))

# Guardar matriz de co-ocurrencia afiliación-afiliación
affil_cooc_df.to_csv(os.path.join(OUTPUT_DIR, "affiliation_affiliation_cooccurrence.csv"), index=False)

# ============================================================
