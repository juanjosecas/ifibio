top_authors = affil_author_matrix.sum(axis=0).sort_values(ascending=False).head(20).index
plt.figure(figsize=(14, 10))
sns.heatmap(
    affil_author_matrix.loc[top_affils, top_authors],
    cmap="viridis",
    annot=True,
    fmt="d",
    linewidths=0.5,
    cbar_kws={"label": "N° de papers compartidos"},
)
plt.title("Heatmap de co-ocurrencia Afiliación-Autor (Top 20)")
plt.xlabel("Autor")
plt.ylabel("Afiliación")
plt.tight_layout()
plt.show()

# Heatmap de co-ocurrencia afiliación-afiliación (solo top 20 por número de co-ocurrencias)
top_affil_pairs = affil_cooc_df.sort_values("Weight", ascending=False).head(20)
pivot_affil = top_affil_pairs.pivot(index="Affiliation1", columns="Affiliation2", values="Weight").fillna(0)
plt.figure(figsize=(12, 10))
