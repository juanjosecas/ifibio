# ============================================================

author_diversity_records = []


for author, data in author_theme_counts.groupby("Author"):

    counts = data["N_Papers"].values

    probabilities = counts / counts.sum()

    entropy = -np.sum(probabilities * np.log(probabilities))

    n_themes = len(counts)

    author_diversity_records.append(
        {"Author": author, "Theme_Entropy": entropy, "N_Themes": n_themes}
    )


author_diversity = pd.DataFrame(author_diversity_records)


display(author_diversity.sort_values("Theme_Entropy", ascending=False).head(30))



