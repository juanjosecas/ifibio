# 25. DIVERSIDAD NORMALIZADA
# ============================================================

author_diversity["Theme_Diversity"] = np.where(
    author_diversity["N_Themes"] > 1,
    author_diversity["Theme_Entropy"] / np.log(author_diversity["N_Themes"]),
