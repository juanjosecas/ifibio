    temp["Theme"] = theme
    temp["Label"] = label

    temp["Rolling3"] = temp["N_Papers"].rolling(3, center=True, min_periods=1).mean()

    theme_year_complete.append(temp)


theme_year_complete = pd.concat(theme_year_complete, ignore_index=True)


