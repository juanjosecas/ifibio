import numpy as np
import pandas as pd
import networkx as nx
import ast

ml_df = df[["PMID", "Title", "Year"]].copy()

ml_df["PMID"] = ml_df["PMID"].astype(str)

print(ml_df.shape)
display(ml_df.head())



# ============================================================
