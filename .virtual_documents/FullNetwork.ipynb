author_clusters.to_pickle(os.path.join("ml_pubmed_ifibio", "author_topic_clusters.pkl"))

cluster_terms_df.to_pickle(
    os.path.join("ml_pubmed_ifibio", "author_topic_cluster_terms.pkl")
