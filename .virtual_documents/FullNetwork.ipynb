# Etiquetar un paper representativo por cluster:
# el más cercano al centro del cluster en UMAP

for cluster in sorted(umap_abs_df["Cluster"].unique()):

    temp = umap_abs_df[umap_abs_df["Cluster"] == cluster].copy()

    center_x = temp["UMAP1"].mean()
    center_y = temp["UMAP2"].mean()

    temp["Distance"] = (temp["UMAP1"] - center_x) ** 2 + (temp["UMAP2"] - center_y) ** 2

    representative = temp.loc[temp["Distance"].idxmin()]

    plt.annotate(
        str(representative["PMID"]),
        (representative["UMAP1"], representative["UMAP2"]),
        fontsize=9,
        fontweight="bold",
    )


plt.xlabel("UMAP 1")
plt.ylabel("UMAP 2")
plt.title("UMAP de abstracts — papers representativos por cluster")

plt.legend(title="Cluster", bbox_to_anchor=(1.02, 1), loc="upper left")

plt.tight_layout()
plt.show()



