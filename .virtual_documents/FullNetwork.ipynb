bridge_records = []


for author in G.nodes():

    author_cluster = cluster_map.get(author)

    neighbors = list(G.neighbors(author))

    external_neighbors = [
        neighbor
        for neighbor in neighbors
        if cluster_map.get(neighbor) != author_cluster
    ]

    internal_neighbors = [
        neighbor
        for neighbor in neighbors
        if cluster_map.get(neighbor) == author_cluster
    ]

    external_clusters = set(
        cluster_map.get(neighbor) for neighbor in external_neighbors
    )

    bridge_records.append(
        {
            "Author": author,
            "Internal_Connections": len(internal_neighbors),
            "External_Connections": len(external_neighbors),
            "External_Clusters": len(external_clusters),
        }
    )


